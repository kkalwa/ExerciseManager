<UserControl x:Class="ExerciseManager.Views.UserPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:ExerciseManager.ViewModels"
             xmlns:local="clr-namespace:ExerciseManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style ="{StaticResource GlobalBackgroundStyle}">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle
            Grid.Column="0"
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Fill="#FFFFFF"/>

        <TextBlock 
            Grid.Column="1" 
            Grid.Row="0" 
            Margin="5" 
            FontSize="20" 
            Text="Witaj w panelu użytkownika" 
            TextAlignment="Right"
            Background="#FFFFFF"/>
        <Button 
            Grid.Column="2"
            Grid.Row="0" 
            Margin="5" 
            Content="Wyloguj się" 
            Padding="5" 
            Command="{Binding LogOutCommand}"/>
       
        <ContentControl Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding CurrentUserControl}" >
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewmodels:ManageExercisesViewModel}">
                    <local:ManageExercisesView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
                    <local:HistoryView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:CreateNewSetViewModel}">
                    <local:CreateNewSetView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ManageTrainingsViewModel}">
                    <local:ManageTrainingsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:CurrentTrainingViewModel}">
                    <local:CurrentTrainingView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewmodels:ManageCurrentTrainingViewModel}">
                    <local:ManageCurrentTrainingView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
        <StackPanel 
            Grid.Column="0" 
            Grid.Row="1"
            Background="#FFFFFF">
            <Button Content="Zarządzaj ćwiczeniami" Margin="5" Command="{Binding ManageExercisesCommand}"/>
            <Button Content="Historia" Margin="5" Command="{Binding CheckHistoryCommand}"/>
            <Button Content="Dodaj trening" Margin="5" Command="{Binding AddNewTrainingCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
