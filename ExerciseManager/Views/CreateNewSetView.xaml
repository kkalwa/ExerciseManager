<UserControl x:Class="ExerciseManager.Views.CreateNewSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExerciseManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style ="{StaticResource GlobalBackgroundStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border 
            Grid.Row="0" 
            Grid.Column="1" 
            Grid.ColumnSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BackgroundBorderStyle}">
        <TextBlock 
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center" 
            FontSize="20" 
            FontWeight="SemiBold" 
            Margin="10" 
            Text="Tworzenie nowego zestawu ćwiczeń"/>
        </Border>

        <TextBlock 
            Grid.Row="1" 
            Grid.Column="4" 
            VerticalAlignment ="Top" 
            HorizontalAlignment="Center" 
            TextAlignment="Center" 
            FontSize="12" 
            Margin="10" 
            Text="Wprowadź ćwiczenia do zestawu"/>

        <TextBlock 
            Grid.Row="1" 
            Grid.Column="4" 
            Foreground="DarkRed" 
            Text="{Binding SQLResultText}"/>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Grid.ColumnSpan="5"
            Style="{StaticResource BackgroundBorderStyle}">
            <StackPanel>
                <TextBlock 
                    Text="Wprowadź nazwę zestawu ćwiczeń:"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"/>
                <TextBox
                    Margin="10"  
                    Text="{Binding ExerciseSetTitle, Mode=TwoWay}"/>
                <StackPanel 
                    Orientation="Horizontal"
                    Margin="5">
                    <TextBlock VerticalAlignment="Top" Width="75" Text="Nazwa" />
                    <TextBlock VerticalAlignment="Top" Width="30" Text="Seria 1"/>
                    <TextBlock VerticalAlignment="Top" Width="30" Text="Seria 2"/>
                    <TextBlock VerticalAlignment="Top" Width="30" Text="Seria 3"/>
                    <TextBlock VerticalAlignment="Top" Width="30" Text="Seria 4"/>
                    <TextBlock VerticalAlignment="Top" Width="30" Text="Seria 5"/>
                </StackPanel>
                <HeaderedItemsControl 
                    Margin="10"
                    ItemsSource="{Binding Exercises}">
                    <HeaderedItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="75" Text="{Binding ExerciseName}"/>
                                <ItemsControl ItemsSource="{Binding ExerciseWeights}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Width="30"  Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <!-- Path=. Not really sure if this is the right way to bind -->
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </HeaderedItemsControl.ItemTemplate>
                </HeaderedItemsControl>
            </StackPanel>
        </Border>
    
        <Button 
            Grid.Row="1" Command="{Binding AddExerciseCommand}" Content="Dodaj zestaw" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"/>
        <Button 
            Grid.Row="1" 
            Grid.Column="1" Command="{Binding AddNewLineCommand}" Content="Dodaj ćwiczenie" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"/>
        <Button 
            Grid.Row="1" 
            Grid.Column="2" Command="{Binding RemoveLineCommand}" Content="Usuń ćwiczenie" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"/>
    </Grid>
</UserControl>
