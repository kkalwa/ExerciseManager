<UserControl x:Class="ExerciseManager.Views.CreateNewSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExerciseManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style ="{StaticResource GlobalBackgroundStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border 
            Grid.Row="0" 
            Grid.Column="1" 
            Grid.ColumnSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource BackgroundBorderStyle}">
            <TextBlock 
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center" 
            FontSize="20" 
            FontWeight="SemiBold" 
            Margin="10" 
            Text="Tworzenie nowego zestawu ćwiczeń"/>
        </Border>

        <TextBlock 
            Grid.Row="1" 
            Grid.Column="4" 
            Foreground="DarkRed" 
            Text="{Binding SQLResultText}"/>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Grid.ColumnSpan="5">
            <Border
            
            Style="{StaticResource BackgroundBorderStyle}">
            <StackPanel>
                <TextBlock 
                    Text="Wprowadź nazwę zestawu ćwiczeń:"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"/>
                <TextBox
                    Margin="10"  
                    Text="{Binding ExerciseSetTitle, Mode=TwoWay}"/>
                
                <DataGrid 
                    Margin="10,10,10,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    ItemsSource="{Binding Exercises}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding ExerciseName}" Width="75"/>
                        <DataGridTextColumn Header="Seria 1" Binding="{Binding ExerciseWeights[0].Value}"/>
                        <DataGridTextColumn Header="Seria 2" Binding="{Binding ExerciseWeights[1].Value}"/>
                        <DataGridTextColumn Header="Seria 3" Binding="{Binding ExerciseWeights[2].Value}"/>
                        <DataGridTextColumn Header="Seria 4" Binding="{Binding ExerciseWeights[3].Value}"/>
                        <DataGridTextColumn Header="Seria 5" Binding="{Binding ExerciseWeights[4].Value}"/>
                        <DataGridTemplateColumn Header="Usuń">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        Command="{Binding DataContext.RemoveExerciseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"
                                        ToolTip="Usuń ten wiersz"
                                        Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse
                                                        x:Name="Ellipse"
                                                        Fill="#E0E0E0"
                                                        Stroke="#333333"
                                                        StrokeThickness="1"
                                                        Width="20"
                                                        Height="15"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    </Ellipse>
                                                    <Path 
                                                        Data="M 2,1 L 4,1"
                                                        Stroke="#333333"
                                                        StrokeThickness="2"
                                                        StrokeStartLineCap="Round" 
                                                        StrokeEndLineCap="Round"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName ="Ellipse" Property="Fill" Value="#FFF9F5F5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button 
                    Content="+"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding AddNewLineCommand}" />
            </StackPanel>
        </Border>
            <Border
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Style="{StaticResource BackgroundBorderStyle}">
        <Button 
            Content="Zatwierdź zestaw" 
            Command="{Binding AddExerciseCommand}" />
            </Border>

        </StackPanel>
        
    </Grid>
</UserControl>
